# ค่าคงที่ของ environment PROD ของ northhr ทุกสคริปต์โหลดไฟล์นี้ผ่าน common.sh (แก้ที่นี่ที่เดียว)
# ทุกบรรทัดเขียนแบบ VAR=${VAR:-ค่า} → ถ้า export ไว้ใน shell แล้ว ค่าใน shell จะชนะค่าในไฟล์นี้
#   เช่น  APP_TAG=v1.4.0 ./5_deploy.sh   หรือ   AGENT_COUNT=0 ./1_create_cluster.sh   หรือ   LOCAL_PORT=5433 ./connect_rds.sh

AWS_REGION=${AWS_REGION:-ap-southeast-1}
LAB_PROFILE=${LAB_PROFILE:-enzodev}          # profile SSO ที่ใช้เมื่อไม่ได้ export AWS_PROFILE ไว้ใน shell

# ชื่อนำหน้าของทุก resource (VPC, EC2, SG, IAM, RDS, S3, SNS, tunnel) ทุกอย่างติด tag lab=<LAB_NAME> ให้ destroy/audit ตามหาได้
LAB_NAME=${LAB_NAME:-northhr-prod}

# เครือข่าย: VPC ของ environment เอง public subnet 2 AZ ไม่มี NAT (node ออกเน็ตผ่าน IGW ด้วย public IP ของตัวเอง, SG ไม่มี inbound จากภายนอก)
# ห้ามให้ VPC_CIDR ทับกับ POD_CIDR/SVC_CIDR ไม่งั้น route ไป VPC DNS (x.x.0.2) จะถูก flannel ดักไว้ CoreDNS จะ SERVFAIL ทุกชื่อภายนอก
VPC_CIDR=${VPC_CIDR:-10.20.0.0/16}
SUBNET_CIDRS=${SUBNET_CIDRS:-"10.20.0.0/24 10.20.1.0/24"}   # 2 subnet คนละ AZ (RDS Multi-AZ และ subnet group ต้องมี 2 AZ)
POD_CIDR=${POD_CIDR:-10.42.0.0/16}                           # k3s --cluster-cidr
SVC_CIDR=${SVC_CIDR:-10.43.0.0/16}                           # k3s --service-cidr

# k3s cluster: server 1 เครื่อง (AZ แรก) + agent AGENT_COUNT เครื่อง (สลับ AZ)  ทุกเครื่อง arm64 (image ของ northhr build arm64)
SERVER_TYPE=${SERVER_TYPE:-t4g.medium}
AGENT_TYPE=${AGENT_TYPE:-t4g.small}
AGENT_COUNT=${AGENT_COUNT:-2}                # ขั้น 1 สร้างให้ครบจำนวนนี้ เพิ่มทีหลังด้วย ./add_node.sh
DISK_GB=${DISK_GB:-30}
K3S_VERSION=${K3S_VERSION:-}                 # ว่าง = stable ล่าสุด  หรือระบุเช่น v1.31.4+k3s1 (ควร pin ใน PROD)
NODE_SG=${NODE_SG:-$LAB_NAME-node-sg}
ROLE_NAME=${ROLE_NAME:-$LAB_NAME-node-role}  # IAM role + instance profile ให้ SSM (ไม่มี SSH key)

# Domain (ทั้งสองต้องอยู่ใต้ ZONE ที่จัดการใน Cloudflare)  hr_mobile build ด้วย BASE_URL=https://DOMAIN_API
ZONE=${ZONE:-nthw.dev}
DOMAIN_BO=${DOMAIN_BO:-hr.$ZONE}             # hr-bo (Next.js back-office)
DOMAIN_API=${DOMAIN_API:-api.hr.$ZONE}       # hr-api (NestJS)

# Cloudflare API token (ไม่บังคับ) ถ้ามี สคริปต์จะสร้าง Tunnel + CNAME ให้เอง
# ใส่ผ่าน export CF_API_TOKEN=... หรือเก็บในไฟล์ .cf_token (อยู่ใน .gitignore) อย่าใส่ token ลงไฟล์นี้
# token ต้องมีสิทธิ์: Account › Cloudflare Tunnel › Edit และ Zone › DNS › Edit ของโซน ZONE
CF_API_TOKEN=${CF_API_TOKEN:-}
TUNNEL_NAME=${TUNNEL_NAME:-$LAB_NAME}
TUNNEL_SECRET=${TUNNEL_SECRET:-cloudflared-token}   # k8s secret ที่เก็บ tunnel token ให้ pod cloudflared
CLOUDFLARED_REPLICAS=${CLOUDFLARED_REPLICAS:-3}     # connector ของ tunnel (กระจายคนละ node ถ้าทำได้)

# images (Docker Hub, arm64)  ขึ้นเวอร์ชันใหม่: APP_TAG=v1.2.3 ./5_deploy.sh  (ทั้ง api และ bo ใช้ tag เดียวกัน)
API_IMAGE=${API_IMAGE:-northhr/hr-api}
BO_IMAGE=${BO_IMAGE:-northhr/hr-bo}
APP_TAG=${APP_TAG:-latest}
API_PORT=${API_PORT:-3000}
BO_PORT=${BO_PORT:-3000}
API_HEALTH_PATH=${API_HEALTH_PATH:-/api/v1/health}
MIGRATE_CMD=${MIGRATE_CMD:-npx prisma migrate deploy}   # รันใน Job migrate ด้วย image ของ hr-api ก่อน rollout ทุกครั้ง
DB_POOL_PER_POD=${DB_POOL_PER_POD:-5}        # connection_limit ใน POSTGRES_PRISMA_URL (pod api สูงสุด 6 × 5 = 30 < max_connections ของ db.t4g.small)

# RDS PostgreSQL (Multi-AZ, encrypted, backup 7 วัน, deletion protection)
DB_ID=${DB_ID:-northhr-prod}
DB_CLASS=${DB_CLASS:-db.t4g.small}
DB_ENGINE_VERSION=${DB_ENGINE_VERSION:-16}
DB_NAME=${DB_NAME:-northhr}
DB_USER=${DB_USER:-northhr}
DB_STORAGE_GB=${DB_STORAGE_GB:-50}
DB_MAX_STORAGE_GB=${DB_MAX_STORAGE_GB:-100}  # storage autoscaling ขยายได้ถึงค่านี้
DB_BACKUP_DAYS=${DB_BACKUP_DAYS:-7}          # automated backup / point-in-time recovery
SG_NAME=${SG_NAME:-$LAB_NAME-rds-sg}
SUBNET_GROUP=${SUBNET_GROUP:-$LAB_NAME-subnets}
K8S_SECRET=${K8S_SECRET:-rds-credentials}    # secret: DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD POSTGRES_PRISMA_URL

# secret ของแอป (JWT, SMTP, Google Maps, ...) อ่านจากไฟล์ SECRETS_FILE (อยู่ใน .gitignore คัดลอกจาก app-secrets.env.example)
APP_SECRET=${APP_SECRET:-app-secrets}
SECRETS_FILE=${SECRETS_FILE:-app-secrets.env}

# S3 สำหรับไฟล์ของ hr-api (presigned URL) ใช้ผ่าน IAM user + access key ที่ขั้น 4 สร้างและใส่ใน app-secrets ให้
S3_BUCKET=${S3_BUCKET:-}                     # ว่าง = <LAB_NAME>-files-<account id> (ชื่อ bucket ต้องไม่ซ้ำทั้งโลก)
S3_USER=${S3_USER:-$LAB_NAME-s3}
S3_NONCURRENT_DAYS=${S3_NONCURRENT_DAYS:-30} # lifecycle: ลบ version เก่าของไฟล์หลังกี่วัน

# แจ้งเตือน RDS ทาง email (ไม่บังคับ) ถ้าใส่ ขั้น 2 จะสร้าง SNS topic + CloudWatch alarm (CPU, พื้นที่ว่าง, memory) ให้
ALARM_EMAIL=${ALARM_EMAIL:-}

# port ในเครื่องสำหรับ SSM tunnel (เลี่ยงพอร์ตมาตรฐานเพราะ 5432/6443 มักถูก Docker/Rancher Desktop ใช้อยู่)
LOCAL_PORT=${LOCAL_PORT:-15432}                # connect_rds.sh  → RDS:5432
K8S_LOCAL_PORT=${K8S_LOCAL_PORT:-16443}        # connect_k8s.sh  → k3s API:6443 (ต้องตรงกับบรรทัด server: ใน ./kubeconfig)
