# คัดลอกเป็น app-secrets.env (อยู่ใน .gitignore) แล้วใส่ค่าจริง  ขั้น 4 จะอ่านไฟล์นี้สร้าง k8s secret app-secrets ให้ pod api/bo อ่านเป็น env
# รูปแบบ KEY=value บรรทัดละตัว ไม่ต้องใส่เครื่องหมายคำพูด (kubectl --from-env-file เก็บทุกตัวอักษรตามที่เขียน)
# ชื่อ KEY ต้องตรงกับที่ hr-api / hr-bo อ่าน (ดู api.env ของ UAT) ค่าที่ยังเป็น CHANGE_ME จะทำให้ขั้น 4 หยุดทำงาน
#
# ค่าที่ขั้น 4 เติมให้เองถ้าไม่มีในไฟล์นี้: AWS_REGION AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_S3_BUCKET CORS_ALLOWED_ORIGINS
# ค่าที่มาจาก secret rds-credentials (ไม่ต้องใส่ที่นี่): DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD POSTGRES_PRISMA_URL

# --- hr-api: JWT ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# --- hr-api: email (SES SMTP หรือ SMTP จริง) ใช้ส่ง OTP / reset password ---
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=NorthHR <no-reply@nthw.dev>

# --- Google Maps (จำกัดสิทธิ์ key ตามโดเมน/แอปใน Google Cloud console) ---
GOOGLE_MAPS_API_KEY=CHANGE_ME
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME

# --- Firebase (FCM push ของ hr_mobile) ถ้า hr-api ใช้ ---
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
